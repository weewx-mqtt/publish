# Bootstrap: the shared settings live in the development-tools checkout.
WEEWX_TOOL_PATH=${WEEWX_TOOL_PATH:-$HOME/weewx_code/weewx-extensions/development-tools/tools}
. "${WEEWX_TOOL_PATH}/devenv.sh"

export WEEWX_MODULE_NAME=mqttpublish

# What the analyze-test workflow lints.
export WEEWX_LINT_PATHS='./bin/user/mqttpublish.py ./bin/user/mqttarchivevalues.py ./bin/user/mqttconfigha.py ./bin/user/mqttaggregatevalues.py ./bin/user/mqtthaconfig.py ./bin/user/mqttcommon.py ./bin/user/mqttmessagetracker.py ./bin/user/mqtttracker.py'

# The shared repositories this repository vendors.
export WEEWX_COMMON_REPOS='https://github.com/weewx-mqtt/mqttcommon'

# The suites the analyze-test workflow runs.
export WEEWX_TEST_SUITES='unit integ'
