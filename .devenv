export WEEWX_MODULE_NAME=mqttpublish

export WEEWX_PYENV_VERSION='3.10'

export WEEWX_TOOL_PATH=~/weewx_dev/weewx-extensions/development-tools/tools

# What the analyze-test workflow lints.
export WEEWX_LINT_PATHS='./bin/user/mqttpublish.py ./bin/user/mqttarchivevalues.py ./bin/user/mqttconfigha.py ./bin/user/mqttaggregatevalues.py ./bin/user/mqtthaconfig.py ./bin/user/mqttcommon.py'

# The suites the analyze-test workflow runs.
export WEEWX_TEST_SUITES='unit integ'

# weewx from PyPI, like CI; the sibling checkout until it is installed.
if PYTHONPATH= python3 -c 'import weewx' >/dev/null 2>&1; then
    export WEEWX_PYTHONPATH=bin
else
    export WEEWX_PYTHONPATH=bin:../weewx/src
fi

PATH=$WEEWX_TOOL_PATH:$PATH
